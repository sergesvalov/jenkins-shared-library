{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pipeline Config Schema",
  "type": "object",
  "required": ["service_name", "stack_type"],
  "properties": {
    "service_name": { "type": "string" },
    "stack_type": { "type": "string", "enum": ["capacitor", "docker-compose", "node"] },
    "target_cluster": { "type": "string" },
    "deploy": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "dir": { "type": "string" },
        "web_port": { "type": "integer" }
      }
    },
    "features": {
      "type": "array",
      "items": { "type": "string", "enum": ["typecheck", "tests", "e2e"] }
    },
    "custom_stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "steps"],
        "properties": {
          "name": { "type": "string" },
          "insert_before": { "type": "string" },
          "insert_after": { "type": "string" },
          "replace": { "type": "string" },
          "steps": { "type": "string" }
        }
      }
    },
    "ports": {
      "type": "object",
      "properties": {
        "host": { "type": "integer" },
        "internal": { "type": "integer" }
      }
    },
    "volumes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "containers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "migrations": {
      "anyOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "properties": {
            "delay": { "type": "integer" },
            "service": { "type": "string" },
            "composeFile": { "type": "string" }
          }
        }
      ]
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "context": { "type": "string" }
        },
        "required": ["name"]
      }
    },
    "envVars": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
